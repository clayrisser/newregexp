{
  "name": "newregexp",
  "version": "2.0.0",
  "description": "Dynamically create regular expressions from strings",
  "keywords": [
    "parse",
    "regex",
    "regexp",
    "regular-expression",
    "string"
  ],
  "homepage": "https://gitlab.com/bitspur/misc/newregexp",
  "bugs": "https://gitlab.com/bitspur/misc/newregexp/-/issues",
  "license": "MIT",
  "author": {
    "name": "Clay Risser",
    "email": "clayrisser@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/bitspur/misc/newregexp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt .",
    "lint": "oxlint && oxfmt --check . && tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1"
}
